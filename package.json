{
  "name": "aimc-assignment",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "studio": "npx remotion studio src/index.jsx",
    "render": "npx remotion render src/index.jsx KaraokeShort --output renders/test.mp4",
    "generate": "node engine.js",
    "render-all": "node render-all.js",
    "pipeline": "node pipeline.js",
    "pipeline:auto": "node pipeline.js --auto",
    "pipeline:dry": "node pipeline.js --dry-run",
    "distribute": "node distributor.js",
    "instagram:test": "node -e \"require('./ig-uploader').testInstagramAuth().then((ok)=>process.exit(ok?0:1))\"",
    "network:test": "node network-diagnostics.js",
    "voice:test": "node voice-smoke.js",
    "media:check": "node media-stack-check.js",
    "ollama:test": "node ollama-health.js",
    "upgrade": "npx @remotion/cli upgrade",
    "scheduler": "node scheduler.js",
    "scheduler:now": "node scheduler.js --now",
    "scheduler:dry": "node scheduler.js --now --dry-run",
    "scheduler:news": "node scheduler.js --now --news",
    "scheduler:story": "node scheduler.js --now --story",
    "prepare:daily": "node daily-script-pack.js",
    "prepare:daily:offline": "set TREND_OFFLINE_MODE=1&& node daily-script-pack.js",
    "daily:check": "node daily-script-pack.js --validate-only",
    "daily:auto": "node scheduler.js --refresh-pack",
    "daily:auto:both": "node public-reel-bridge.js -- scheduler.js --refresh-pack --instagram",
    "daily:locked": "node scheduler.js",
    "daily:locked:both": "node public-reel-bridge.js -- scheduler.js --instagram",
    "daily:auto:now": "node scheduler.js --refresh-pack --now",
    "daily:auto:both:now": "node public-reel-bridge.js -- scheduler.js --refresh-pack --now --instagram",
    "daily:auto:dry": "node scheduler.js --refresh-pack --now --dry-run",
    "analytics:youtube": "node refresh-youtube-analytics.js",
    "analytics:slots": "node optimize-upload-slots.js",
    "today:auto:both": "node public-reel-bridge.js -- run-today.js --gap-minutes 60 --instagram",
    "start-story-pipeline": "node run-today.js --story --gap-minutes 60 --instagram",
    "stop-all": "taskkill /IM node.exe /F",
    "start-full-pipeline": "node scheduler.js",
    "story:start": "node pipeline-cli.js start",
    "story:dry": "node pipeline-cli.js start --dry-run",
    "story:yt": "node pipeline-cli.js start --youtube-only",
    "story:stop": "node pipeline-cli.js stop",
    "story:status": "node pipeline-cli.js status",
    "story:auth": "node pipeline-cli.js test-auth",
    "story:preview": "node pipeline-cli.js preview",
    "story:logs": "node pipeline-cli.js logs",
    "story:reset": "node pipeline-cli.js reset-story",
    "start-daemon": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ragnar-pipeline",
    "restart": "pm2 restart ragnar-pipeline",
    "status": "pm2 status",
    "logs": "pm2 logs ragnar-pipeline --lines 50",
    "monitor": "pm2 monit"
  },
  "keywords": [],
