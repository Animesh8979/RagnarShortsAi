    "ffprobe-static": "^3.1.0",
    "google-auth-library": "^10.6.2",
    "google-tts-api": "^2.0.2",
    "googleapis": "^171.4.0",
    "kokoro-js": "^1.2.1",
    "maath": "^0.10.8",
    "msedge-tts": "^2.0.4",
    "node-fetch": "^2.7.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.436",
    "three": "^0.184.0"
