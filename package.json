{
  "name": "@antigravity/work",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered automated short-form video pipeline for YouTube & Instagram",
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "pipeline": "npm run start -w apps/pipeline",
    "studio": "npm run start -w apps/studio",
    "web": "npm run dev -w apps/web"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/skills/*"
  ],
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}