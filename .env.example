# Antigravity Work v2.0 Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# RENDERING
# =============================================================================
# Directory for all video renders (MUST be on D: drive)
RENDER_DIR=D:\antigravity-renders

# =============================================================================
# LOGGING
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# AI / LLM (Ollama)
# =============================================================================
# Ollama local LLM endpoint
OLLAMA_URL=http://localhost:11434

# Model to use for script generation (qwen3:1.7b recommended for speed/quality balance)
OLLAMA_MODEL=qwen3:1.7b

# =============================================================================
# OPTIONAL: Social Media APIs
# =============================================================================
# YouTube Data API v3 key (optional - only needed for upload automation)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram Graph API access token (optional - only needed for upload automation)
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# =============================================================================
# OPTIONAL: MCP Services
# =============================================================================
# Brave Search API key (optional - needed for trend research)
# BRAVE_API_KEY=your_brave_api_key_here
